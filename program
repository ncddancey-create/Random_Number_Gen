import random

DIGIT_RANGE = int(input("What is your digit range? (starting from 0)"))

def generate_number():
    while True:
        digit = DIGIT_RANGE + 1
        numbers = range(1,digit)
        number = random.choice(numbers)
        print(f"Your number: {number}")

        again = input("Whould you like another number? (Y/N)").upper().strip()

        if again == "Y":
            continue
        elif again == "N":
            break
        else:
            print("Invalid Input: Please Type either Yes or No")
    
        


generate_number()
